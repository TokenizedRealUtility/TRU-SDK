# Copy to apps/quantum-wallet/.env or run: npm run quantum:setup
# Only Local mode is enabled by default. Session secret generated on each start.
TRU_QUANTUM_UI_MODE=local
TRU_QUANTUM_UI_PORT=24833

# For private HTTPS LAN mode (requires TLS certificate and firewall allowlist):
# TRU_QUANTUM_UI_MODE=lan
# TRU_QUANTUM_UI_HOST=192.168.1.209
# TRU_QUANTUM_UI_PUBLIC_HOST=192.168.1.209
# TRU_QUANTUM_ALLOWED_CLIENT_IP=192.168.1.82
# TRU_QUANTUM_TLS_CERT=/home/youruser/.tru-quantum-ui/tls/lan-192-168-1-209.crt
# TRU_QUANTUM_TLS_KEY=/home/youruser/.tru-quantum-ui/tls/lan-192-168-1-209.key
# Advanced ONLY: allow wildcard bind with exact approved client IP + TLS certificate.
# TRU_QUANTUM_UI_HOST=0.0.0.0
# TRU_QUANTUM_UI_PUBLIC_HOST=192.168.1.209
# TRU_QUANTUM_ALLOW_WILDCARD_BIND=YES_I_UNDERSTAND

# Optional: Core RPC stays on the SAME machine at loopback. Never expose to the LAN.
# TRU_RPC_URL=http://127.0.0.1:21832/rpc
# TRU_RPC_TOKEN=  # Prefer Core's local authenticated cookie rather than hardcoding a token.
